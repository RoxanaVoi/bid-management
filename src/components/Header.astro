---
import { getLocaleFromUrl, getNavItems, getAlternateLocale, getLocalizedPath, t } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);

const altLocale = getAlternateLocale(locale);
const navItems = getNavItems(locale);
const currentPath = Astro.url.pathname.replace(`/${locale}`, '') || '/';
// Nu toate paginile au pereche tradusa. Fara verificarea asta, butonul de
// limba ducea la 404 pe paginile care exista doar intr-o limba.
const paginiExistente = Object.keys(import.meta.glob('/src/pages/**/*.astro'));
const caleCurata = currentPath.replace(/\/$/, '') || '/';
const caleAlternativa = `/src/pages/${altLocale}${caleCurata === '/' ? '/index' : caleCurata}`;
const areTraducere = paginiExistente.some(
  (f) => f === `${caleAlternativa}.astro` || f === `${caleAlternativa}/index.astro`
);
const altHref = areTraducere
  ? getLocalizedPath(altLocale, currentPath)
  : getLocalizedPath(altLocale, '/');
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-18">
      <!-- Logo -->
      <a href={getLocalizedPath(locale, '/')} class="flex items-center shrink-0">
        <!-- Lockup-ul complet are raport 6:1; pe ecrane mici rămâne doar badge-ul. -->
        <img src="/images/logo-equalys-mark.svg" alt="Equalys" class="h-9 w-auto sm:hidden" />
        <img src="/images/logo-equalys-2026.svg" alt="Equalys Services — bid-management.ro · speed-flow.ai" class="hidden sm:block h-8 lg:h-9 w-auto" />
      </a>

      <!-- Desktop nav.
           Cu trei audiențe în meniu, etichetele nu mai încap pe un rând la
           1280-1440px, așa că textul rămâne întreg și se strâng în jurul lui
           spațierea și corpul de literă, până la xl. -->
      <nav class="hidden lg:flex items-center gap-1">
        {navItems.map((item) => {
          const activ =
            Astro.url.pathname === item.href ||
            Astro.url.pathname.startsWith(item.href + '/') ||
            (item.copii ?? []).some((c) => Astro.url.pathname.startsWith(c.href));
          const stil = [
            'px-3 py-2 text-sm font-medium rounded-lg transition-colors whitespace-nowrap',
            activ ? 'text-accent bg-accent/10' : 'text-navy-light hover:text-accent hover:bg-accent/5',
          ];

          if (!item.copii) return <a href={item.href} class:list={stil}>{item.label}</a>;

          // Deschis la hover și la focus din tastatură, fără JavaScript.
          return (
            <div class="relative group">
              <a href={item.href} class:list={[...stil, 'inline-flex items-center gap-1']}>
                {item.label}
                <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </a>
              <div class="absolute left-0 top-full pt-2 w-64 invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 transition-opacity duration-150">
                <div class="bg-white rounded-xl shadow-lg border border-gray-100 p-1.5">
                  {item.copii.map((c) => (
                    <a
                      href={c.href}
                      class:list={[
                        'block px-3 py-2.5 text-sm font-medium rounded-lg transition-colors',
                        Astro.url.pathname.startsWith(c.href)
                          ? 'text-accent bg-accent/10'
                          : 'text-navy-light hover:text-accent hover:bg-accent/5',
                      ]}
                    >
                      {c.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          );
        })}
      </nav>

      <!-- Right side -->
      <div class="flex items-center gap-3">
        <!-- Language switcher -->
        <a
          href={altHref}
          class="px-3 py-1.5 text-sm font-medium border border-navy/10 rounded-lg hover:bg-accent/5 hover:border-accent/30 transition-colors"
        >
          {altLocale.toUpperCase()}
        </a>

        <!-- Instrumentul principal, scos din meniu ca sa nu mai stea
             la acelasi nivel cu sectiuni intregi -->
        <a
          href={getLocalizedPath(locale, '/analizeaza-documentatia')}
          class="hidden sm:inline-flex items-center gap-2 px-4 py-2 bg-accent hover:bg-accent-dark text-white text-sm font-semibold rounded-lg transition-colors no-underline whitespace-nowrap"
        >
          {t(locale, 'nav.analizeaza')}
        </a>

        <!-- Mobile menu toggle -->
        <button
          id="menu-toggle"
          class="lg:hidden p-2 rounded-lg hover:bg-gray-100 transition-colors"
          aria-label="Toggle menu"
        >
          <svg id="menu-icon" class="w-6 h-6 text-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-6 h-6 text-navy hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-gray-100">
    <div class="max-w-7xl mx-auto px-4 py-4 space-y-1">
      {navItems.map((item) =>
        item.copii ? (
          <div class="pt-1">
            <p class="px-4 pt-2 pb-1 text-[11px] font-semibold tracking-widest uppercase text-text-light">
              {item.label}
            </p>
            {item.copii.map((c) => (
              <a
                href={c.href}
                class:list={[
                  'block px-4 py-3 text-sm font-medium rounded-lg transition-colors',
                  Astro.url.pathname.startsWith(c.href)
                    ? 'text-accent bg-accent/10'
                    : 'text-navy-light hover:text-accent hover:bg-accent/5',
                ]}
              >
                {c.label}
              </a>
            ))}
          </div>
        ) : (
          <a
            href={item.href}
            class:list={[
              'block px-4 py-3 text-sm font-medium rounded-lg transition-colors',
              Astro.url.pathname === item.href
                ? 'text-accent bg-accent/10'
                : 'text-navy-light hover:text-accent hover:bg-accent/5',
            ]}
          >
            {item.label}
          </a>
        )
      )}
    </div>
  </div>
</header>

<!-- Spacer for fixed header -->
<div class="h-18"></div>

<script>
  const header = document.getElementById('site-header')!;
  const menuToggle = document.getElementById('menu-toggle')!;
  const mobileMenu = document.getElementById('mobile-menu')!;
  const menuIcon = document.getElementById('menu-icon')!;
  const closeIcon = document.getElementById('close-icon')!;

  // Scroll effect
  let lastScroll = 0;
  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;
    if (currentScroll > 50) {
      header.classList.add('bg-white/90', 'backdrop-blur-md', 'shadow-sm');
    } else {
      header.classList.remove('bg-white/90', 'backdrop-blur-md', 'shadow-sm');
    }
    lastScroll = currentScroll;
  });

  // Mobile toggle
  menuToggle.addEventListener('click', () => {
    const isOpen = !mobileMenu.classList.contains('hidden');
    mobileMenu.classList.toggle('hidden');
    menuIcon.classList.toggle('hidden');
    closeIcon.classList.toggle('hidden');
    if (!isOpen) {
      header.classList.add('bg-white/90', 'backdrop-blur-md');
    }
  });
</script>
