---
import { getLocaleFromUrl, getLocalizedPath } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);

const label = locale === 'ro' ? 'Au scris despre soluțiile Equalys' : 'They wrote about Equalys solutions';
const cta = locale === 'ro' ? 'Vezi aparițiile →' : 'See coverage →';
const despreHref = getLocalizedPath(locale, '/despre') + '#presa';

const outlets = [
  { name: 'Ziarul Financiar', short: 'ZF' },
  { name: 'ZF IT Generation', short: 'IT Generation' },
  { name: 'Profit.ro', short: 'Profit.ro' },
];
---

<section class="py-10 bg-surface border-y border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <p class="text-sm font-medium text-text-light uppercase tracking-widest shrink-0">{label}</p>

      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
        {outlets.map((o) => (
          <span class="text-navy font-heading font-bold text-lg opacity-70 hover:opacity-100 transition-opacity whitespace-nowrap">
            {o.name}
          </span>
        ))}
      </div>

      <a href={despreHref} class="text-accent text-sm font-medium hover:underline shrink-0 whitespace-nowrap">
        {cta}
      </a>
    </div>
  </div>
</section>
