        <span class="mx-2">/</span>
        <a href={getLocalizedPath(locale, '/resurse')} class="hover:text-accent transition-colors">Resurse</a>
        <span class="mx-2">/</span>
        <span class="text-gray-400">Paradigma controlului</span>
      </nav>
      <div class="flex items-center gap-2 mb-4">
