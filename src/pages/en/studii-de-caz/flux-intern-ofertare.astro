---
import CaseStudyLayout from '../../../layouts/CaseStudyLayout.astro';
const locale = 'en';
---
<CaseStudyLayout
  title="An internal bidding flow for large documentation"
  description="Case study: blockages between commercial, technical and finance, resolved through clear roles and a bidding flow that is easy to follow."
  noSuffix
  subtitle="We clarified the blockages between commercial, technical and finance through clear roles and a bidding flow that is easy to follow on large documentation."
  meta="Processes · Internal organisation"
  label="Processes"
  context="On large procedures, the company lost time in handovers between the teams involved in preparing the bid."
  challenge="Nobody held the whole picture, and the deadline pressure fell on whoever happened to be closest to it."
  challengeBullets={["Unclear responsibilities between departments.", "Information scattered across e-mails and folders.", "Validations left to the last day."]}
  interventionIntro="We mapped the actual flow and rebuilt it around who decides what, and when."
  interventionSteps={["We established roles for each stage.", "We set the validation points before submission.", "We centralised the working documents."]}
  resultText="The bidding process became easier to follow, and the final stages stopped depending on a single person."
  resultHighlights={["Clear responsibilities per stage", "Validations planned, not improvised", "Less time lost in handovers"]}
/>
