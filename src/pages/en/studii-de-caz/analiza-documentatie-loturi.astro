---
import CaseStudyLayout from '../../../layouts/CaseStudyLayout.astro';
const locale = 'en';
---
<CaseStudyLayout
  title="Analysing a multi-lot tender documentation"
  description="Case study: a voluminous documentation, requirements split across lots, and restrictive points surfaced before the decision to bid."
  noSuffix
  subtitle="We went through a voluminous documentation, separated the requirements by lot and surfaced the restrictive points before the decision to bid."
  meta="Analysis · Multiple lots"
  label="Analysis"
  context="The company was considering a procedure with several lots and needed to understand quickly where it could realistically take part."
  challenge="The documentation was large, and the requirements differed from one lot to another."
  challengeBullets={["Requirements scattered across several documents.", "Differences between lots, hard to compare.", "A short deadline before submission."]}
  interventionIntro="We mapped the documentation lot by lot and marked the points that could affect eligibility."
  interventionSteps={["We separated the requirements for each lot.", "We marked the potentially restrictive points.", "We summarised what the company could cover with its own resources."]}
  resultText="The company could decide which lots to bid for, with the reasons written down."
  resultHighlights={["A clear comparison between lots", "Restrictive points identified in time", "A documented decision to take part"]}
/>
