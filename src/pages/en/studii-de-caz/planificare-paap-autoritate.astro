---
import CaseStudyLayout from '../../../layouts/CaseStudyLayout.astro';
const locale = 'en';
---
<CaseStudyLayout
  title="Planning needs and structuring the annual plan"
  description="Case study at a contracting authority: collecting needs becomes a predictable flow of prioritisation and documentation, with a solid basis for the annual plan."
  noSuffix
  subtitle="Collecting needs became a predictable flow of prioritisation and documentation, with a solid basis for the annual procurement plan."
  meta="Planning · Contracting authority"
  label="Planning"
  context="The institution collected its needs differently from one department to another, and the annual plan was assembled late and under pressure."
  challenge="Without a common way of collecting needs, the plan could not be defended line by line."
  challengeBullets={["Needs sent in different formats.", "No link between the need and the budget line.", "Changes without a documented cause."]}
  interventionIntro="We established a single way of collecting needs and the minimum content of each request."
  interventionSteps={["We set the minimum fields of a needs memo.", "We linked each need to its funding source.", "We established how changes are recorded."]}
  resultText="The plan was built from documented needs, and each line could be traced back to its origin."
  resultHighlights={["A single way of collecting needs", "Each line traceable to a memo", "Changes with a documented cause"]}
/>
