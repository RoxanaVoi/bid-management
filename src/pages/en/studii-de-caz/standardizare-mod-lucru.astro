---
import CaseStudyLayout from '../../../layouts/CaseStudyLayout.astro';
const locale = 'en';
---
<CaseStudyLayout
  title="Standardising how recurring procedures are handled"
  description="Case study: templates and checklists for recurring procedures, so that each bid is no longer started from scratch by the team."
  noSuffix
  subtitle="We built templates and checklists for recurring procedures, so that each bid is no longer started from scratch."
  meta="Processes · Standardisation"
  label="Processes"
  context="The company took part regularly in similar procedures, but each bid was prepared as if it were the first."
  challenge="The knowledge gained on one procedure did not carry over to the next."
  challengeBullets={["Documents rewritten from scratch each time.", "Mistakes repeated across procedures.", "Dependence on the people who had done it before."]}
  interventionIntro="We turned what the team already did well into reusable material."
  interventionSteps={["We built templates for recurring documents.", "We set a checklist before submission.", "We wrote down the lessons from completed procedures."]}
  resultText="Preparing a bid became faster, and the quality stopped depending on who happened to be available."
  resultHighlights={["Reusable templates", "A checklist applied before every submission", "Lessons kept, not lost"]}
/>
