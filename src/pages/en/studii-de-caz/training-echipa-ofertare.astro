---
import CaseStudyLayout from '../../../layouts/CaseStudyLayout.astro';
const locale = 'en';
---
<CaseStudyLayout
  title="Training a team for public tendering"
  description="Case study: an applied training programme on reading tender documentation, preparing the ESPD and coordinating the internal bidding stages."
  noSuffix
  subtitle="We built an applied training programme covering how to read tender documentation, prepare the ESPD and coordinate the internal bidding stages."
  meta="Training · Internal processes"
  label="Training"
  context="The company wanted to raise the capability of the team involved in public procurement and reduce its dependence on ad-hoc or uneven approaches."
  challenge="Team members needed a shared, practical framework for understanding documentation and organising the bidding stages."
  challengeBullets={["Different levels of experience across the team.", "No common way of working.", "A need for applied examples, not just theory."]}
  interventionIntro="We built a training programme oriented towards real situations and the concrete stages of taking part in public procedures."
  interventionSteps={["We covered how to read tender documentation.", "We included preparing the ESPD and the bid itself.", "We clarified the internal flow and the team roles."]}
  resultText="The team gained a common working framework and a more coherent approach to taking part in public procedures."
  resultHighlights={["More clarity in interpreting documentation", "More structured internal collaboration", "A more predictable bid preparation process"]}
/>
