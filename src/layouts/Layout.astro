---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { getLocaleFromUrl, getLocalizedPath, getAlternateLocale } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** JSON-LD suplimentar pentru pagină: Service, FAQPage, HowTo etc.
   *  Se adaugă peste Organization/WebSite/BreadcrumbList, care vin din oficiu. */
  schema?: Record<string, unknown>[];
  /** Titlurile descriptive depășesc bugetul afișat în rezultatele căutării.
   *  Cu noSuffix, " | Bid Management" nu se mai adaugă. */
  noSuffix?: boolean;
}

const {
  title,
  description,
  ogImage,
  schema = [],
  noSuffix = false,
} = Astro.props;
const site = Astro.site ?? new URL('https://bid-management.ro');
// Descrierea implicită urmează limba paginii; până acum paginile EN
// moșteneau una în română.
const DESCRIERE_IMPLICITA: Record<string, string> = {
  ro: 'Consultanță specializată în achiziții publice pentru autorități contractante și operatori economici. ePAAP — platformă pentru PAAP și referate de necesitate.',
  en: 'Public procurement consulting for Romanian contracting authorities and economic operators. ePAAP — a platform for the annual plan and needs memos.',
};
// Social platforms require an absolute URL; a relative path is silently dropped.
const ogImageUrl = new URL(ogImage ?? '/images/og-default-2026.png', site).href;
const locale = getLocaleFromUrl(Astro.url);
const descriere = description ?? DESCRIERE_IMPLICITA[locale] ?? DESCRIERE_IMPLICITA.ro;
const altLocale = getAlternateLocale(locale);
const currentPath = Astro.url.pathname.replace(`/${locale}`, '') || '/';
const altPath = getLocalizedPath(altLocale, currentPath);
const fullTitle = noSuffix ? title : `${title} | Bid Management`;

// ── Breadcrumb ────────────────────────────────────────────────────────────
// Motoarele de căutare afișează calea sub rezultat, iar cele generative o
// folosesc ca să înțeleagă unde stă pagina în site.
const SEGMENT_LABELS: Record<string, Record<string, string>> = {
  ro: {
    resurse: 'Resurse',
    solutii: 'Soluții',
    'studii-de-caz': 'Studii de caz',
    autoritati: 'Autorități contractante',
    companii: 'Operatori economici',
    contact: 'Contact',
    despre: 'Despre noi',
    'analizeaza-documentatia': 'Analizează documentația',
  },
  en: {
    resurse: 'Resources',
    solutii: 'Solutions',
    'studii-de-caz': 'Case studies',
    autoritati: 'Contracting authorities',
    companii: 'Economic operators',
    contact: 'Contact',
    despre: 'About',
    'analizeaza-documentatia': 'Document analysis',
  },
};

const prettify = (s: string) =>
  s.replace(/-/g, ' ').replace(/^\w/, (c) => c.toUpperCase());

// Un hreflang care trimite spre 404 invalideaza perechea. Verificam la
// build daca pagina alternativa exista cu adevarat.
const paginiExistente = Object.keys(import.meta.glob('/src/pages/**/*.astro'));
const caleFaraLocale = altPath.replace(`/${altLocale}`, '').replace(/\/$/, '') || '/';
const caleAlternativa = `/src/pages/${altLocale}${caleFaraLocale === '/' ? '/index' : caleFaraLocale}`;
const areTraducere = paginiExistente.some(
  (f) => f === `${caleAlternativa}.astro` || f === `${caleAlternativa}/index.astro`
);

const segments = currentPath.split('/').filter(Boolean);
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: locale === 'ro' ? 'Acasă' : 'Home',
      item: new URL(`/${locale}/`, site).href,
    },
    ...segments.map((seg, i) => ({
      '@type': 'ListItem',
      position: i + 2,
      name: SEGMENT_LABELS[locale]?.[seg] ?? prettify(seg),
      item: new URL(`/${locale}/${segments.slice(0, i + 1).join('/')}`, site).href,
    })),
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={descriere} />
    <meta name="generator" content={Astro.generator} />

    <!-- Bing Webmaster verification -->
    <meta name="msvalidate.01" content="4AD1BB1A80D67D2327750D174DB2CF51" />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={descriere} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:locale" content={locale === 'ro' ? 'ro_RO' : 'en_US'} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Bid Management" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={descriere} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Alternate languages -->
    <link rel="alternate" hreflang={locale} href={`https://bid-management.ro${getLocalizedPath(locale, currentPath)}`} />
    {areTraducere && (
      <link rel="alternate" hreflang={altLocale} href={`https://bid-management.ro${altPath}`} />
    )}
    <link rel="canonical" href={Astro.url.href} />

    <link rel="icon" type="image/svg+xml" href="/favicon-2026.svg" />
    <title>{fullTitle}</title>

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Equalys Services",
        "alternateName": "Bid Management",
        "url": "https://bid-management.ro",
        "logo": "https://bid-management.ro/images/logo-equalys-2026.svg",
        "description": "Consultanță specializată în achiziții publice pentru autorități contractante și operatori economici.",
        "email": "office@bid-management.ro",
        "telephone": "+40746188797",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "București",
          "addressCountry": "RO"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+40746188797",
          "email": "office@bid-management.ro",
          "contactType": "customer service",
          "availableLanguage": ["Romanian", "English"]
        },
        "sameAs": ["https://linkedin.com/company/equalys-services"]
      },
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Bid Management",
        "url": "https://bid-management.ro",
        "inLanguage": ["ro", "en"],
        "description": "Consultanță achiziții publice, ePAAP, eBid — instrumente digitale pentru planificare, analiză și ofertare."
      },
      breadcrumb,
      ...schema
    ])} />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <CookieConsent />

  </body>
</html>
